{
  "_comment": [
    "Urist's MCP set (Dwarf Fortress Archon, aion:2). Loaded with --mcp-config +",
    "--strict-mcp-config so it REPLACES the root .mcp.json rather than merging.",
    "",
    "GRAPHITI_GROUP_ID MUST be declared HERE, not only in the launcher. The root .mcp.json",
    "declares it as a LITERAL 'jarvis-core', and an env value declared in an MCP server's",
    "config overrides the launching process's environment \u2014 so exporting it in launch-aion.sh",
    "alone silently does nothing and Urist's entities land in the Master Archon's graph.",
    "Learned on the Genie install, repeated on Jacques, and it is the single easiest thing",
    "to get wrong when adding a lane.",
    "",
    "scholar-gateway, annas-archive and arxiv are omitted deliberately: Urist's domain is",
    "fortress state, DFHack tooling and the Chronicler pipeline, not literature search.",
    "Smaller tool surface, smaller prompt, and one less place a tracked secret travels.",
    "If DF wiki or academic lookup ever becomes real work, add it as a decision on record."
  ],
  "mcpServers": {
    "annas-archive": {
      "command": "/Users/nathanielcannon/Claude/Projects/AnnasTools/.venv/bin/python",
      "args": [
        "/Users/nathanielcannon/Claude/Projects/AnnasTools/src/annas_tools/mcp_server.py"
      ],
      "env": {
        "ANNAS_SECRET_KEY": "${ANNAS_SECRET_KEY}",
        "ANNAS_DOWNLOAD_PATH": "/Users/nathanielcannon/Claude/Project_Aion/projects/annas_archive/library"
      },
      "disabled": false
    },
    "arxiv": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "arxiv-mcp-server"
      ],
      "env": {
        "ARXIV_STORAGE_PATH": "/Users/nathanielcannon/Claude/Project_Aion/projects/urist/arxiv"
      }
    },
    "jarvis-graphiti": {
      "command": "/Users/nathanielcannon/Claude/Project_Aion/infrastructure/.venv/bin/python",
      "args": [
        "/Users/nathanielcannon/Claude/Project_Aion/infrastructure/rag-service/graphiti_mcp_server.py"
      ],
      "env": {
        "NEO4J_URI": "bolt://localhost:7687",
        "NEO4J_USER": "neo4j",
        "NEO4J_PASSWORD": "${NEO4J_PASSWORD}",
        "LITELLM_BASE_URL": "http://localhost:4000/v1",
        "OLLAMA_BASE_URL": "http://localhost:8000/v1",
        "LLM_MODEL": "qwen3-8b-nothink",
        "EMBED_MODEL": "qwen3-embedding:4b",
        "EMBEDDING_DIM": "2560",
        "GRAPHITI_GROUP_ID": "urist-core"
      }
    },
    "jarvis-pulse": {
      "command": "/Users/nathanielcannon/Claude/Project_Aion/infrastructure/.venv/bin/python",
      "args": [
        "/Users/nathanielcannon/Claude/Project_Aion/infrastructure/rag-service/pulse_mcp_server.py"
      ],
      "env": {
        "PULSE_URL": "http://localhost:8800/api/v1"
      }
    },
    "jarvis-rag": {
      "command": "/Users/nathanielcannon/Claude/Project_Aion/infrastructure/.venv/bin/python",
      "args": [
        "/Users/nathanielcannon/Claude/Project_Aion/infrastructure/rag-service/mcp_server.py"
      ],
      "env": {
        "MLX_EMBED_URL": "http://localhost:8000",
        "QDRANT_URL": "http://localhost:6333"
      }
    },
    "scholar-gateway": {
      "command": "/Users/nathanielcannon/Claude/Projects/ScholarGateway/.venv/bin/python",
      "args": [
        "/Users/nathanielcannon/Claude/Projects/ScholarGateway/src/scholar_gateway/mcp_server.py"
      ],
      "env": {
        "SCHOLAR_DOWNLOAD_PATH": "/Users/nathanielcannon/Claude/Project_Aion/projects/urist/papers"
      },
      "disabled": false
    }
  }
}
