<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  JICM multi-session supervisor.

  WHY THIS EXISTS: jicm-supervisor.sh is the ONLY component that actuates any lane
  except W0, and nothing had ever started it — no launcher entry, no cron, no agent.
  Its log had not moved since 2026-07-25. Consequence: every lane sensed its own
  threshold correctly, raised a clear-now signal, and nothing consumed it. All seven
  JICM cycles in this system's history were fired by hand. Discovered 2026-08-12 while
  the dev lane sat at 2x its hard threshold with an unanswered signal on disk.

  JICM_SUPERVISOR_ACTUATE=1 is set HERE rather than changing the script's default,
  which stays 0. A hand-run supervisor therefore remains sense-only and safe; only this
  deliberate production path opts into autonomous clearing.

  JICM_SUPERVISOR_INCLUDE_W0=1 since 2026-08-12 — W0 is now managed like every other
  lane. What changed:

    - The RACE is gone. jicm-watcher.sh no longer consumes .jicm-clear-now.signal; it
      runs with JICM_WATCHER_CYCLE_ENABLED=false (set in launch-aion.sh). It is NOT
      retired: it still owns REST/idle-hands (incl. the R5 scratchpad prune), MAINTAIN
      health pings, and identity checks, none of which the supervisor has. Killing it
      to end the race would have silently dropped three live capabilities.
    - Shadow mode no longer keys on watcher process-liveness (wrong test once the
      process outlives its cycling role) but on the watcher-owns-cycling marker file.
    - The HALT-handshake parity gap is CLOSED, not waived: the flush is folded forward
      into jicm-actuate.sh step 1.5 for every lane. The legacy handshake was only ~75%
      effective (41 of 164 cycles hit the ack timeout), but 75% is not 0%, so it was
      reimplemented rather than dropped. See _step_flush.

  To roll back: set this to 0, and set JICM_WATCHER_CYCLE_ENABLED=true in launch-aion.sh.
  Never leave BOTH managers cycling — that is the original race.

  PATH includes /usr/sbin: cron/launchd omit it, and lsof lives there.

  Install:  cp to ~/Library/LaunchAgents/ && launchctl load -w ~/Library/LaunchAgents/com.aion.jicm-supervisor.plist
  Status:   launchctl list | grep jicm-supervisor
  Stop:     launchctl unload -w ~/Library/LaunchAgents/com.aion.jicm-supervisor.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aion.jicm-supervisor</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/nathanielcannon/Claude/Project_Aion/.claude/scripts/jicm-supervisor.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PROJECT_DIR</key>
        <string>/Users/nathanielcannon/Claude/Project_Aion</string>
        <key>CLAUDE_PROJECT_DIR</key>
        <string>/Users/nathanielcannon/Claude/Project_Aion</string>
        <key>JICM_PROJECT_DIR</key>
        <string>/Users/nathanielcannon/Claude/Project_Aion</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/nathanielcannon</string>
        <key>TMUX_BIN</key>
        <string>/Users/nathanielcannon/bin/tmux</string>
        <key>JICM_TMUX_BIN</key>
        <string>/Users/nathanielcannon/bin/tmux</string>
        <key>JICM_SUPERVISOR_ACTUATE</key>
        <string>1</string>
        <key>JICM_SUPERVISOR_INCLUDE_W0</key>
        <string>1</string>
        <key>JICM_SUPERVISOR_POLL</key>
        <string>10</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>/Users/nathanielcannon/Claude/Project_Aion</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/nathanielcannon/Claude/Project_Aion/.claude/logs/jicm-supervisor.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/nathanielcannon/Claude/Project_Aion/.claude/logs/jicm-supervisor.stderr.log</string>
</dict>
</plist>
