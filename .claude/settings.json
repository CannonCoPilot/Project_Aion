{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "description": "Jarvis default permissions - safe operations without prompting",
  "version": "1.2",
  "plansDirectory": ".claude/plans",
  "mcpToolSearch": "auto:15",
  "mcpServers": {
    "scholar-gateway": {
      "command": "/Users/nathanielcannon/Claude/Projects/ScholarGateway/.venv/bin/python",
      "args": [
        "/Users/nathanielcannon/Claude/Projects/ScholarGateway/src/scholar_gateway/mcp_server.py"
      ],
      "env": {
        "SCHOLAR_DOWNLOAD_PATH": "/Users/nathanielcannon/Claude/Projects/palimpsest/research/papers"
      }
    },
    "annas-archive": {
      "command": "/Users/nathanielcannon/Claude/Projects/AnnasTools/.venv/bin/python",
      "args": [
        "/Users/nathanielcannon/Claude/Projects/AnnasTools/src/annas_tools/mcp_server.py"
      ],
      "env": {
        "ANNAS_SECRET_KEY": "${ANNAS_SECRET_KEY}",
        "ANNAS_DOWNLOAD_PATH": "/Users/nathanielcannon/Claude/Projects/palimpsest/research/papers"
      }
    },
    "arxiv": {
      "command": "uvx",
      "args": [
        "arxiv-mcp-server"
      ],
      "env": {
        "ARXIV_STORAGE_PATH": "/Users/nathanielcannon/Claude/Projects/palimpsest/research/papers"
      }
    }
  },
  "statusLine": {
    "type": "command",
    "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/jarvis-statusline-v9.sh"
  },
  "hooks": {
    "Setup": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/setup-hook.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/jicm-precompact.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/scratchpad-rotate.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/jicm-stop.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/stop-hook.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/exit-guard.sh"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/insight-capture.js"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/refresh-ccusage-cache.sh &"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/scripts/refresh-ratelimit-cache.sh &"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/bash-safety-guard.js"
          }
        ]
      },
      {
        "matcher": "^(Read|Write|Edit)$",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/bash-safety-guard.js"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/context-injector.js"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/prompt-overflow-guard.js"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/jicm-gate.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/pre-clear-context-prep.sh"
          },
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/prompt-timestamp.sh"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/orchestration-detector.js"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/self-correction-capture.js",
            "async": true
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/permission-gate.js"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/wiggum-loop-tracker.js",
            "async": true
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/milestone-coordinator.js"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/context-health-monitor.js"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/relevance-retrieval.js"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/ulfhedthnar-detector.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$|^mcp__git__git_commit$",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/cross-project-commit-tracker.js",
            "async": true
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/docker-monitor.js",
            "async": true
          }
        ]
      },
      {
        "matcher": "^(Task|Skill|WebSearch|WebFetch|EnterPlanMode|Read)$|^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/usage-tracker.js",
            "async": true
          }
        ]
      },
      {
        "matcher": "^(Read|Bash|Grep|Glob|WebFetch|WebSearch)$",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/observation-tracker.js",
            "async": true
          }
        ]
      },
      {
        "matcher": "^TodoWrite$",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/milestone-coordinator.js"
          }
        ]
      },
      {
        "matcher": "^Write$",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/memory-mirror.js",
            "async": true
          }
        ]
      },
      {
        "matcher": "^(Task|Bash)$",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/ulfhedthnar-detector.js"
          }
        ]
      },
      {
        "matcher": "^(Task|TaskCreate|TaskUpdate)$",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/virgil-tracker.js",
            "async": true
          }
        ]
      },
      {
        "matcher": "^ExitPlanMode$",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/plan-tracker.js",
            "async": true
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/jicm-gate.sh",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/session-tracker.js",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/subagent-stop.js",
            "async": true
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/ulfhedthnar-detector.js"
          },
          {
            "type": "command",
            "command": "node $CLAUDE_PROJECT_DIR/.claude/hooks/virgil-tracker.js",
            "async": true
          }
        ]
      }
    ]
  },
  "permissions": {
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "/Users/nathanielcannon/Claude/Projects"
    ],
    "allow": [
      "Agent",
      "Bash(*)",
      "Edit",
      "Edit(/Users/nathanielcannon/Claude/Project_Aion/alfred/**)",
      "Edit(/Users/nathanielcannon/Claude/Projects/**)",
      "Glob",
      "Grep",
      "Read",
      "Read(/Users/nathanielcannon/Claude/Project_Aion/.claude/secrets/**)",
      "Skill",
      "WebFetch",
      "WebSearch",
      "Write",
      "mcp__annas-archive",
      "mcp__jarvis-graphiti",
      "mcp__jarvis-pulse",
      "mcp__jarvis-rag",
      "mcp__scholar-gateway"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(**/.env)",
      "Edit(/Users/nathanielcannon/Claude/Archive/AIfred/**)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf /home/*)",
      "Bash(sudo rm -rf:*)",
      "Bash(mkfs:*)",
      "Bash(dd if=:*)",
      "Bash(chmod -R 777 /*)",
      "Bash(chown -R:*)",
      "mcp__jarvis-rag__delete_file"
    ],
    "_denyPolicy": [
      "GENEROUS BY DESIGN — read is open to every Archon, write is broadly allowed, and only",
      "IRREVERSIBLE DESTRUCTION is denied. That mirrors the Bash rules above (rm -rf, mkfs, dd):",
      "the guard is against unrecoverable loss, not against the lanes doing their work.",
      "",
      "Every Archon now loads all 6 project MCP servers plus all claude.ai connectors, so these",
      "rules apply uniformly — there is no per-lane MCP scoping left to hide behind.",
      "",
      "mcp__jarvis-rag__delete_file is the ONLY verified destructive MCP tool in the estate:",
      "it drops every vector for a file from a Qdrant collection. Everything else either writes",
      "(allowed) or changes state reversibly (pulse_close). graphiti has no delete tool, and its",
      "add_episode now REFUSES cross-group writes in the server itself, which is a stronger",
      "guarantee than a permission rule because it cannot be bypassed by a lane that skips these",
      "settings.",
      "",
      "NO GMAIL/DRIVE/CALENDAR DENY RULES ARE LISTED, DELIBERATELY. Those connectors expose only",
      "authenticate + complete_authentication until OAuth completes, so their real tool names are",
      "UNKNOWABLE right now. A guessed rule like mcp__claude_ai_Gmail__send_message would match",
      "nothing and read as protection while protecting nothing — the same dead-rule class as the",
      "Write(path) rules Claude Code used to warn about on every startup (removed 2026-08-25: only",
      "Edit(path) rules are matched by file permission checks, and Edit covers ALL file-editing",
      "tools including Write). ADD THEM AFTER AUTHENTICATING:",
      "  1. authenticate the connector, 2. list its real tool names, 3. deny the destructive ones",
      "     (permanent delete, empty trash) here, using the exact names.",
      "Until then the guard is bypassPermissions plus the operator, not a fictional rule."
    ]
  }
}
