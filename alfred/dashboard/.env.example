# Pulse Dashboard Configuration
# Copy to .env and fill in values

# Required — Pulse API connection
PULSE_API_URL=http://pulse:8700/api/v1
PULSE_DASHBOARD_TOKEN=

# Workspace
DEFAULT_WORKSPACE=MyProject
WORKSPACE_DIR=/workspace
TZ=UTC

# Web Push notifications (optional)
# Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional integrations
OLLAMA_URL=http://localhost:11434

# Neo4j / Graphiti knowledge-graph overview route.
# Value lives in .claude/secrets/credentials.yaml at .database.neo4j.password.
# Never commit a value here - this file is tracked and the repo is public.
NEO4J_USER=neo4j
NEO4J_PASSWORD=
